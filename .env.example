# Local SQLite Database (Default for zero-config local run)
DATABASE_URL="file:./dev.db"

# Optional PostgreSQL for Neon/Supabase production:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/nihongo_lms?schema=public"

# Auth & Session Security
NEXTAUTH_SECRET="your-secure-random-secret-key-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="your-secure-random-jwt-secret-key"

# Japanese AI Tutor Engine (Local Fine-Tuned Qwen2.5-1.5B QLoRA Service)
# Run locally via: npm run tutor:server or bash ai-tutor/scripts/start_fullstack.sh
AI_TUTOR_URL="http://127.0.0.1:8000"
AI_TUTOR_API_KEY=""

# Optional Cloud LLM Fallback (Google Gemini API)
# Get your free key from https://aistudio.google.com
GEMINI_API_KEY=""

# Course Instructor Contact (for administrative/grading escalations)
INSTRUCTOR_EMAIL="tanaka.sensei@rit.edu"
