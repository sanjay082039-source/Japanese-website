// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Model: Admin/Staff and Students
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT") // "ADMIN", "STUDENT"
  courseLevel  String   // "N1", "N2", "N3", "N4", "N5"
  section      String   @default("A")       // e.g. "A", "B", "Weekend"
  phone        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  attendances           Attendance[]
  taughtSlots           TimetableSlot[]        @relation("StaffTimetableSlots")
  examAttempts          ExamAttempt[]
  assignmentSubmissions AssignmentSubmission[]

  @@index([role])
  @@index([courseLevel])
  @@index([email])
}

// Attendance tracking hour by hour
model Attendance {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime
  hourSlot  String   // e.g. "09:00 - 10:00", "10:00 - 11:00", etc.
  status    String   // "PRESENT", "ABSENT", "ON_LEAVE"
  subject   String?
  remarks   String?
  isOffline Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([studentId, date])
  @@index([date, hourSlot])
  @@index([isOffline])
}

// Hourly Timetable Slot
model TimetableSlot {
  id          String   @id @default(cuid())
  dayOfWeek   Int      // 1 = Monday, 2 = Tuesday, ..., 6 = Saturday, 7 = Sunday
  startTime   String   // "09:00"
  endTime     String   // "10:00"
  courseLevel String   // "N1", "N2", "N3", "N4", "N5"
  subject     String   // e.g. "Kanji & Vocabulary", "Grammar & Dokkai", "Listening Comprehension"
  room        String?  @default("Room 101")
  staffId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff       User?    @relation("StaffTimetableSlots", fields: [staffId], references: [id], onDelete: SetNull)

  @@index([courseLevel, dayOfWeek])
  @@index([staffId])
}

// Examination Management
model Exam {
  id              String   @id @default(cuid())
  title           String
  description     String?
  courseLevel     String   // "N1", "N2", "N3", "N4", "N5"
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int
  totalMarks      Int
  passingMarks    Int      @default(50)
  isPublished     Boolean  @default(false)
  proctoringRules String?  // JSON string: { clipboardBlock: true, devtoolsBlock: true, tabSwitchLimit: 3, fullScreenRequired: true }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questions       ExamQuestion[]
  attempts        ExamAttempt[]

  @@index([courseLevel, isPublished])
  @@index([startTime, endTime])
}

// Questions belonging to an Exam
model ExamQuestion {
  id            String   @id @default(cuid())
  examId        String
  questionText  String
  questionType  String   @default("MCQ") // "MCQ" or "SUBJECTIVE"
  optionsJson   String   // JSON string array of options: ["Option A", "Option B", ...]
  correctOption String   // "0", "1", "2", "3" or correct text
  marks         Int      @default(1)
  orderIndex    Int      @default(0)

  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

// Student Attempt for an Exam
model ExamAttempt {
  id           String      @id @default(cuid())
  examId       String
  studentId    String
  startedAt    DateTime    @default(now())
  submittedAt  DateTime?
  score        Float?
  status       String      @default("IN_PROGRESS") // "IN_PROGRESS", "SUBMITTED", "AUTO_SUBMITTED", "DISQUALIFIED"
  answersJson  String?     // JSON of student answers: { [questionId]: answer }
  cheatLogJson String?     // JSON log of violations: [{ type, timestamp, details }]
  cheatCount   Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  exam         Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  student      User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  violations   CheatViolationLog[]

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([examId])
}

// Granular Proctoring & Anti-Cheat Violation Forensics
model CheatViolationLog {
  id          String      @id @default(cuid())
  attemptId   String
  violationType String    // "TAB_SWITCH", "DEVTOOLS_ATTEMPT", "CLIPBOARD_COPY", "CLIPBOARD_PASTE", "FULLSCREEN_EXIT", "WINDOW_BLUR"
  details     String?
  timestamp   DateTime    @default(now())
  severity    String      @default("WARNING") // "INFO", "WARNING", "CRITICAL"

  attempt     ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([violationType])
}

// Assignments
model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String
  courseLevel String   // "N1", "N2", "N3", "N4", "N5"
  dueDate     DateTime
  maxMarks    Int      @default(100)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions AssignmentSubmission[]

  @@index([courseLevel, dueDate])
}

// Student Assignment Submissions
model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  studentId    String
  content      String     // Rich-text or textual response
  fileUrl      String?    // Uploaded document URL or relative file path
  submittedAt  DateTime   @default(now())
  grade        Float?
  feedback     String?
  status       String     @default("SUBMITTED") // "SUBMITTED", "GRADED", "LATE"

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId, studentId])
  @@index([studentId])
}
